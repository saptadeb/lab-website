---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { VISIBLE_NAV } from '~/config/site';
import { url } from '~/lib/url';
---

<BaseLayout title="Page not found" noindex>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="font-display text-6xl text-brand">404</p>
    <h1 class="mt-4 text-3xl">That page moved or never existed</h1>
    <p class="mt-4 text-ink-muted">
      Try one of these instead, or head back to the <a
        class="text-brand hover:underline"
        href={url('/')}>home page</a
      >.
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2">
      {
        VISIBLE_NAV.map((item) => (
          <li>
            <a
              class="rounded-md border border-line px-4 py-2 text-sm hover:border-brand hover:text-brand"
              href={url(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
