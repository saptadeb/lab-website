---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import NewsCard from '~/components/NewsCard.astro';
import PublicationEntry from '~/components/PublicationEntry.astro';
import { SITE, PAGES } from '~/config/site';
import { url } from '~/lib/url';

const published = <T extends { data: { draft: boolean } }>(items: T[]) =>
  items.filter((item) => import.meta.env.DEV || !item.data.draft);

const projects = published(await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const news = published(await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const pubs = (await getCollection('publications'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
---

<BaseLayout>
  <section class="border-b border-line bg-surface-alt">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <p class="text-sm font-medium uppercase tracking-widest text-brand">
        {SITE.department} · {SITE.institution}
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{SITE.name}</h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-muted">{SITE.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          PAGES.research && (
            <a
              class="rounded-md bg-brand px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-dark"
              href={url('/research')}
            >
              Our research
            </a>
          )
        }
        {
          PAGES.join && (
            <a
              class="rounded-md border border-line px-5 py-2.5 text-sm font-medium transition-colors hover:border-brand hover:text-brand"
              href={url('/join')}
            >
              Join the lab
            </a>
          )
        }
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-16">
    {
      projects.length > 0 && (
        <section class="mb-16">
          <SectionHeading title="Research areas" href={url('/research')} />
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="grid gap-16 lg:grid-cols-2">
      {
        pubs.length > 0 && (
          <section>
            <SectionHeading
              title="Selected publications"
              href={url('/publications')}
            />
            <ul>
              {pubs.map((pub) => (
                <PublicationEntry pub={pub} />
              ))}
            </ul>
          </section>
        )
      }

      {
        news.length > 0 && (
          <section>
            <SectionHeading title="Latest news" href={url('/news')} />
            <div>
              {news.map((post) => (
                <NewsCard post={post} showImage={false} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>
