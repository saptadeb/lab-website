---
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Map from '~/components/Map.astro';
import { SITE } from '~/config/site';
---

<PageLayout title="Contact" description={`Get in touch with ${SITE.name}.`}>
  <div class="grid gap-12 lg:grid-cols-2">
    <div>
      <h2 class="text-xl">Get in touch</h2>
      <ContactForm />
    </div>

    <div>
      <h2 class="text-xl">Find us</h2>
      <address class="mt-4 space-y-0.5 not-italic text-ink-muted">
        {SITE.contact.address.map((line) => <div>{line}</div>)}
      </address>
      <p class="mt-3 text-sm">
        <a class="text-brand hover:underline" href={`mailto:${SITE.contact.email}`}>
          {SITE.contact.email}
        </a>
        {SITE.contact.phone && <span class="text-ink-muted"> · {SITE.contact.phone}</span>}
      </p>

      <div class="mt-6">
        <Map />
      </div>
    </div>
  </div>
</PageLayout>
