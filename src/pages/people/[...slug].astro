---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PublicationEntry from '~/components/PublicationEntry.astro';
import { url } from '~/lib/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const people = (await getCollection('people')).filter(
    (p) => import.meta.env.DEV || !p.data.draft,
  );
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
};

const { person } = Astro.props;
const d = person.data;
const { Content } = await render(person);

const links = [
  d.links.website && { label: 'Website', href: d.links.website },
  d.links.scholar && { label: 'Google Scholar', href: d.links.scholar },
  d.links.orcid && { label: 'ORCID', href: d.links.orcid },
  d.links.github && { label: 'GitHub', href: d.links.github },
  d.links.linkedin && { label: 'LinkedIn', href: d.links.linkedin },
  d.links.x && { label: 'X', href: d.links.x },
].filter(Boolean) as { label: string; href: string }[];

// Publications this person authored, matched on surname within the author string.
const surname = d.name.split(' ').at(-1) ?? d.name;
const pubs = (await getCollection('publications'))
  .filter((pub) => pub.data.authors.some((a) => a.includes(surname)))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title={d.name} description={d.blurb ?? `${d.name} — ${d.title ?? ''}`}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-[220px_1fr]">
      <div>
        {
          d.photo ? (
            <Image
              src={d.photo}
              alt={`Portrait of ${d.name}`}
              width={440}
              height={550}
              class="w-full rounded-card object-cover"
            />
          ) : (
            <div class="aspect-4/5 rounded-card bg-surface-alt" />
          )
        }

        <dl class="mt-5 space-y-3 text-sm">
          {
            d.email && (
              <div>
                <dt class="font-medium">Email</dt>
                <dd class="break-all">
                  <a class="text-brand hover:underline" href={`mailto:${d.email}`}>
                    {d.email}
                  </a>
                </dd>
              </div>
            )
          }
          {
            links.length > 0 && (
              <div>
                <dt class="font-medium">Links</dt>
                <dd>
                  <ul class="mt-1 space-y-1">
                    {links.map((link) => (
                      <li>
                        <a
                          class="text-brand hover:underline"
                          href={link.href}
                          target="_blank"
                          rel="noopener"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            d.interests.length > 0 && (
              <div>
                <dt class="font-medium">Interests</dt>
                <dd class="text-ink-muted">{d.interests.join(', ')}</dd>
              </div>
            )
          }
          {
            d.currentAffiliation && (
              <div>
                <dt class="font-medium">Now at</dt>
                <dd class="text-ink-muted">{d.currentAffiliation}</dd>
              </div>
            )
          }
        </dl>
      </div>

      <div>
        <h1 class="text-3xl">{d.name}</h1>
        {d.title && <p class="mt-1 text-lg text-ink-muted">{d.title}</p>}

        <div class="prose-lab mt-6">
          <Content />
        </div>

        {
          pubs.length > 0 && (
            <section class="mt-12">
              <h2 class="mb-2 border-b border-line pb-2 text-xl">Publications</h2>
              <ul>
                {pubs.map((pub) => (
                  <PublicationEntry pub={pub} />
                ))}
              </ul>
            </section>
          )
        }

        <p class="mt-12">
          <a class="text-sm text-brand hover:underline" href={url('/people')}>← All people</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
