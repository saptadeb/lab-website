---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import NewsCard from '~/components/NewsCard.astro';
import { SITE } from '~/config/site';
import { url } from '~/lib/url';

const posts = (await getCollection('news'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout
  title="News"
  lede="Lab announcements, papers, talks, and awards."
  width="prose"
  description={`News and updates from ${SITE.name}.`}
>
  {
    posts.length > 0 ? (
      <div>
        {posts.map((post) => (
          <NewsCard post={post} />
        ))}
      </div>
    ) : (
      <p class="text-ink-muted">Posts will appear here.</p>
    )
  }

  <p class="mt-10 text-sm text-ink-muted">
    Subscribe via <a class="text-brand hover:underline" href={url('/rss.xml')}>RSS</a>.
  </p>
</PageLayout>
