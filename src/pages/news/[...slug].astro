---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDate, isoDate } from '~/lib/format';
import { url } from '~/lib/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = (await getCollection('news')).filter(
    (p) => import.meta.env.DEV || !p.data.draft,
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
---

<BaseLayout title={d.title} description={d.summary} type="article">
  <article class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <time datetime={isoDate(d.date)} class="text-sm uppercase tracking-wide text-ink-muted">
      {formatDate(d.date)}
    </time>
    <h1 class="mt-2 text-3xl sm:text-4xl">{d.title}</h1>
    {d.summary && <p class="mt-4 text-lg text-ink-muted">{d.summary}</p>}

    {
      d.image && (
        <Image
          src={d.image}
          alt={d.imageAlt ?? ''}
          width={1200}
          height={675}
          class="mt-8 w-full rounded-card object-cover"
        />
      )
    }

    <div class="prose-lab mt-8">
      <Content />
    </div>

    {
      d.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {d.tags.map((tag) => (
            <li class="rounded-full bg-surface-alt px-2.5 py-1 text-xs text-ink-muted">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-12">
      <a class="text-sm text-brand hover:underline" href={url('/news')}>← All news</a>
    </p>
  </article>
</BaseLayout>
