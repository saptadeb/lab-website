---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '~/layouts/PageLayout.astro';
import PublicationEntry from '~/components/PublicationEntry.astro';
import { url } from '~/lib/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = (await getCollection('projects')).filter(
    (p) => import.meta.env.DEV || !p.data.draft,
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);

// Publications that point at this project, plus any sharing a topic tag.
const allPubs = await getCollection('publications');
const related = allPubs
  .filter(
    (pub) =>
      pub.data.project?.id === project.id ||
      pub.data.topics.some((topic) => project.data.topics.includes(topic)),
  )
  .sort((a, b) => b.data.year - a.data.year);
---

<PageLayout
  title={project.data.title}
  lede={project.data.summary}
  width="prose"
  description={project.data.summary}
>
  {
    project.data.thumbnail && (
      <Image
        src={project.data.thumbnail}
        alt=""
        width={1200}
        height={675}
        class="mb-10 w-full rounded-card object-cover"
      />
    )
  }

  <div class="prose-lab">
    <Content />
  </div>

  {
    related.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-2 border-b border-line pb-2 text-xl">Related publications</h2>
        <ul>
          {related.map((pub) => (
            <PublicationEntry pub={pub} />
          ))}
        </ul>
      </section>
    )
  }

  <p class="mt-12">
    <a class="text-sm text-brand hover:underline" href={url('/research')}>
      ← All research areas
    </a>
  </p>
</PageLayout>
