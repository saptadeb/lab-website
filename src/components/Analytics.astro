---
import { SITE } from '~/config/site';

const { provider, id } = SITE.analytics;

// Nothing is loaded until an id is configured, so the site ships tracker-free.
const enabled = provider !== 'none' && id !== '';
---

{
  enabled && provider === 'goatcounter' && (
    <script
      is:inline
      defer
      data-goatcounter={`https://${id}.goatcounter.com/count`}
      src="//gc.zgo.at/count.js"
    />
  )
}
{
  enabled && provider === 'cloudflare' && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${id}"}`}
    />
  )
}
{
  enabled && provider === 'plausible' && (
    <script is:inline defer data-domain={id} src="https://plausible.io/js/script.js" />
  )
}
{
  enabled && provider === 'ga4' && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </Fragment>
  )
}
