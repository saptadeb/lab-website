---
import { SITE, PAGES } from '~/config/site';
import { url } from '~/lib/url';

const socials = [
  { key: 'x', label: 'X', href: SITE.social.x },
  { key: 'bluesky', label: 'Bluesky', href: SITE.social.bluesky },
  { key: 'linkedin', label: 'LinkedIn', href: SITE.social.linkedin },
  { key: 'github', label: 'GitHub', href: SITE.social.github },
  { key: 'scholar', label: 'Google Scholar', href: SITE.social.scholar },
  { key: 'youtube', label: 'YouTube', href: SITE.social.youtube },
].filter((s) => s.href);

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface-alt">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="font-display text-lg">{SITE.name}</p>
      <p class="mt-1 text-sm text-ink-muted">{SITE.department}</p>
      <p class="text-sm text-ink-muted">{SITE.institution}</p>
    </div>

    <div class="text-sm">
      <p class="font-medium">Contact</p>
      <address class="mt-2 space-y-0.5 not-italic text-ink-muted">
        {SITE.contact.address.map((line) => <div>{line}</div>)}
        <div>
          <a class="hover:text-brand hover:underline" href={`mailto:${SITE.contact.email}`}
            >{SITE.contact.email}</a
          >
        </div>
        {SITE.contact.phone && <div>{SITE.contact.phone}</div>}
      </address>
    </div>

    <div class="text-sm">
      {
        socials.length > 0 && (
          <>
            <p class="font-medium">Elsewhere</p>
            <ul class="mt-2 space-y-1">
              {socials.map((s) => (
                <li>
                  <a
                    class="text-ink-muted hover:text-brand hover:underline"
                    href={s.href}
                    rel="me noopener"
                    target="_blank"
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      {PAGES.news && (
        <a class="mt-3 inline-block text-ink-muted hover:text-brand hover:underline" href={url('/rss.xml')}>
          RSS feed
        </a>
      )}
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-8 text-xs text-ink-muted">
    <p>
      © {year} {SITE.name}.
      {PAGES.privacy && (
        <>
          {' · '}<a class="hover:underline" href={url('/privacy')}>Privacy &amp; accessibility</a>
        </>
      )}
    </p>
  </div>
</footer>
