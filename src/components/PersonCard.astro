---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '~/lib/url';

interface Props {
  person: CollectionEntry<'people'>;
  /** Alumni render as a compact row rather than a photo card. */
  compact?: boolean;
}

const { person, compact = false } = Astro.props;
const { name, title, photo, blurb, currentAffiliation, yearsInLab } = person.data;
const href = url(`/people/${person.id}`);
---

{
  compact ? (
    <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line py-3">
      <a class="font-medium hover:text-brand hover:underline" href={href}>{name}</a>
      <span class="text-sm text-ink-muted">
        {[yearsInLab, currentAffiliation].filter(Boolean).join(' · ')}
      </span>
    </li>
  ) : (
    <li class="group">
      <a href={href} class="block">
        <div class="aspect-4/5 overflow-hidden rounded-card bg-surface-alt">
          {photo ? (
            <Image
              src={photo}
              alt={`Portrait of ${name}`}
              width={480}
              height={600}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex h-full items-center justify-center font-display text-4xl text-ink-muted">
              {name
                .split(' ')
                .map((part) => part[0])
                .slice(0, 2)
                .join('')}
            </div>
          )}
        </div>
        <h3 class="mt-3 text-base font-medium group-hover:text-brand">{name}</h3>
        {title && <p class="text-sm text-ink-muted">{title}</p>}
        {blurb && <p class="mt-1 text-sm text-ink-muted">{blurb}</p>}
      </a>
    </li>
  )
}
